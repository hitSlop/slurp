   "ok": false,
   "rejected": [
    2
   ]
  },
  {
   "name": "valid batch with trailing newline",
   "body": "{\"id\":\"opaque\",\"type\":\"track\",\"event\":\"visit\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"data\": {\"values\":[-0,1e1000,1.2300,9007199254740993123456789],\"text\":\"\\ud83d\\ude00\"}}\n{\"id\":\"two\",\"type\":\"identify\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"user_id\":\"alice\",\"data\":{\"plan\":null}}\n",
   "ok": true,
   "lines": 2
  },
  {
   "name": "valid batch with CRLF",
   "body": "{\"id\":\"opaque\",\"type\":\"track\",\"event\":\"visit\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"data\": {\"values\":[-0,1e1000,1.2300,9007199254740993123456789],\"text\":\"\\ud83d\\ude00\"}}\r\n{\"id\":\"two\",\"type\":\"identify\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"user_id\":\"alice\",\"data\":{\"plan\":null}}\r\n",
   "ok": true,
   "lines": 2
  },
  {
   "name": "blank lines are skipped but still counted",
