{
  "name": "slurp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "RegistryDO" },
      { "name": "PROJECT", "class_name": "ProjectDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RegistryDO", "ProjectDO"] }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "slurp-archive" }],
  "vars": {
    "SEAL_INTERVAL_MS": "600000",
    "SEAL_MAX_BYTES": "8388608",
    "GROUP_COMMIT_MS": "500",
    "BUFFER_CAP_BYTES": "67108864",
    "RETENTION_DAYS": "0",
    "MAX_BODY_BYTES": "10485760"
  },
  "observability": { "enabled": true }
}
