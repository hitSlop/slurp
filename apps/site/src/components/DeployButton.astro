---
import {deployButtonUrl} from '../lib/config.mjs';
const {label='Deploy to Cloudflare'}=Astro.props;
const url=deployButtonUrl();
---
<a class="btn btn-cloudflare" href={url || '/docs/#terminal-deploy'}>{label}<span aria-hidden="true">↗</span></a>
<style>
.btn-cloudflare{gap:18px;background:#f6821f;border-color:#f6821f;color:#23190f;font-weight:650;min-height:46px}
.btn-cloudflare:hover{background:#ed7514;border-color:#ed7514}
.btn-cloudflare span{font-size:18px}
</style>
