{{- define "main" -}}
{{- if ne .WebrpcVersion "v1" -}}
  {{- stderrPrintf "gen-rust: unsupported webrpc version %s\n" .WebrpcVersion -}}{{- exit 1 -}}
{{- end -}}
{{- if not (minVersion .WebrpcGenVersion "v0.49.0") -}}
  {{- stderrPrintf "gen-rust: requires webrpc-gen v0.49.0 or newer, got %s\n" .WebrpcGenVersion -}}{{- exit 1 -}}
{{- end -}}
{{- range $k, $v := .Opts -}}
  {{- stderrPrintf "gen-rust: -%s=%q is not supported target option\n" $k $v -}}{{- exit 1 -}}
{{- end -}}
{{- template "validate" . -}}
// Code generated by webrpc-gen@{{.WebrpcGenVersion}} with gen-rust. DO NOT EDIT.
// Schema: {{.SchemaName}} {{.SchemaVersion}} {{.SchemaHash}}
// {{.WebrpcGenCommand}}

pub const WEBRPC_HEADER: &str = "Webrpc";
pub const WEBRPC_HEADER_VALUE: &str = {{printf "%q" .WebrpcHeader}};

{{template "collections" .}}
{{template "types" .}}
{{template "errors" .}}
{{template "clients" .}}
{{- end -}}

{{- define "ident" -}}
{{- $name := snakeCase . -}}
{{- if in $name "abstract" "as" "async" "await" "become" "box" "break" "const" "continue" "do" "dyn" "else" "enum" "extern" "false" "final" "fn" "for" "gen" "if" "impl" "in" "let" "loop" "macro" "match" "mod" "move" "mut" "override" "priv" "pub" "ref" "return" "static" "struct" "trait" "true" "try" "type" "typeof" "union" "unsafe" "unsized" "use" "virtual" "where" "while" "yield" -}}r#{{- end -}}{{$name}}
{{- end -}}

{{- define "rust-type" -}}
{{- if isListType . -}}Vec<{{template "rust-type" (listElemType .)}}>
{{- else if isMapType . -}}std::collections::BTreeMap<String, {{template "rust-type" (mapValueType .)}}>
{{- else -}}
  {{- $types := dict "bool" "bool" "string" "String" "int8" "i8" "int16" "i16" "int32" "i32" "int64" "i64" "uint8" "u8" "uint16" "u16" "uint32" "u32" "uint64" "u64" "float32" "f32" "float64" "f64" "timestamp" "chrono::DateTime<chrono::Utc>" "any" "serde_json::Value" -}}
  {{- if isCoreType . -}}{{get $types (toString .)}}{{- else -}}{{.}}{{- end -}}
{{- end -}}
{{- end -}}

{{- define "json-name" -}}
{{- $name := .Field.Name -}}
{{- $goName := firstLetterToUpper .Field.Name -}}
{{- range .Field.Meta -}}
  {{- if exists . "go.field.name" -}}{{- $goName = get . "go.field.name" -}}{{- end -}}
  {{- if exists . "json" -}}{{- $name = get . "json" -}}{{- end -}}
  {{- if exists . "go.tag.json" -}}{{- $name = first (split "," (get . "go.tag.json")) -}}{{- end -}}
{{- end -}}
{{- set . "Name" (default $name $goName) -}}
{{- end -}}

{{- define "types" -}}
{{range .Types}}
{{range .Comments}}/// {{.}}
{{end}}{{if isAliasType .}}pub type {{.Name}} = {{template "rust-type" .Type}};
{{else}}
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
pub struct {{.Name}} {
{{- range .Fields}}
{{- $wire := dict "Field" . -}}{{- template "json-name" $wire -}}{{- $json := $wire.Name -}}
{{- if ne $json "-"}}
{{range .Comments}}    /// {{.}}
{{end}}    #[serde(rename = {{printf "%q" $json}})]
{{if .Optional}}    #[serde(default, skip_serializing_if = "Option::is_none")]
{{else if or (isListType .Type) (isMapType .Type)}}    #[serde(default, deserialize_with = "null_as_default")]
{{end}}    pub {{template "ident" .Name}}: {{if .Optional}}Option<{{end}}{{template "rust-type" .Type}}{{if .Optional}}>{{end}},
{{- end}}
{{- end}}
}
{{end}}
{{end}}
{{- end -}}

{{- define "collections" -}}
{{- $needed := false -}}
{{- range .Types -}}{{- range .Fields -}}
{{- $wire := dict "Field" . -}}{{- template "json-name" $wire -}}
{{- if and (ne $wire.Name "-") (not .Optional) (or (isListType .Type) (isMapType .Type)) -}}{{- $needed = true -}}{{- end -}}
{{- end -}}{{- end -}}
{{if $needed}}
fn null_as_default<'de, D, T>(d: D) -> Result<T, D::Error>
where
    D: serde::Deserializer<'de>,
    T: Default + serde::Deserialize<'de>,
{
    Ok(<Option<T> as serde::Deserialize>::deserialize(d)?.unwrap_or_default())
}
{{end}}
{{- end -}}
