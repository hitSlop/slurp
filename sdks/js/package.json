{
  "name": "@hitslop/slurp-sdk",
  "version": "0.2.1",
  "description": "Browser and Node event capture for Slurp: durable queue, safe retries and batching. No runtime dependencies.",
  "keywords": [
    "analytics",
    "product-analytics",
    "events",
    "tracking",
    "slurp",
    "cloudflare",
    "duckdb",
    "coding-agents"
  ],
  "license": "MIT",
  "author": "Longtail Labs",
  "homepage": "https://slurp.run/docs/#capture",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hitSlop/slurp.git",
    "directory": "sdks/js"
  },
  "bugs": {
    "url": "https://github.com/hitSlop/slurp/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "default": "./dist/feedback.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p . --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "typescript": "5.9.3"
  }
}
