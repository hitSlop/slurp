webrpc = v1

name = slurp
version = v0.6.0
basepath = /rpc

# Slurp backend: the public client API (webrpc, POST JSON per method). webrpc-gen v0.49.0 syntax:
# per-method errors go on indented `+ error A | B` lines below the method signature.
# Each method is tagged `+ @public` (supported for clients outside this repo: archive reads, health, whoami) or
# `+ @internal` (CLI and control-plane plumbing). `@public` means supported for third parties, not unauthenticated: archive
# reads still need a key. webrpc-gen filters on that: `-match=@public` keeps only the public
# methods and `-ignore=@internal` drops the internal ones (the `@` is required). The Worker and the CLI are generated from the
# whole schema; a client published for third parties would be generated with `-match=@public`.
# SDK ingest is NOT here: POST /v1/events stays a plain HTTP endpoint (raw NDJSON bodies, a
# byte-exact dedupe hash, 503 + Retry-After). See docs/architecture.md.

# An archive sequence number as a decimal string, so it survives JavaScript numbers (> 2^53).
type Seq: string

# Where a project's archive stands. Sequences have no holes; objects below firstRetained may
# already be deleted.
struct Coverage
  # The current archive. A different id than the one a library has synced is an archive reset.
  - archiveId: string
  # The lowest sequence that may still exist (with nothing retained: the next sequence).
  - firstRetained: Seq
  # Null until something is published. A lower bound: the bucket may already hold more.
  - latestPublished?: Seq
  # When the latest published object was created.
  - latestPublishedAt?: timestamp
  # The archive retention window in seconds. 0 means archives are kept until they are deleted.
  - retentionSeconds: uint64

# One immutable archive object, downloadable with a plain GET of url until expiresAt.
struct ArchiveObject
  # The object sequence number.
  - seq: Seq
  # `<20-digit seq>-<sha256>.jsonl.gz` (gzip NDJSON).
  - name: string
  # Compressed object size in bytes.
  - size: uint64
  # sha256 of the object's bytes; verify before importing.
  - sha256: string
  # A presigned GET. It carries no credentials of the caller; never forward Authorization.
  - url: string

# List immutable archive objects for a project.
struct ListObjectsRequest
  # The project to access.
  - project: string
  # Exclusive start: the caller's committed checkpoint. Null starts at coverage.firstRetained,
  # which is how a new library bootstraps (never a gap).
  - after?: Seq
  # Default 1000, at most 5000.
  - limit?: uint32

# A page of objects and the archive retention range.
struct ListObjectsResponse
  # Null when the project has no archive yet (then objects is empty).
  - coverage?: Coverage
    + go.tag.json = coverage
  # Ascending by seq; contiguous unless an object is missing from the bucket. Never null.
  - objects: []ArchiveObject
  # Set when more objects follow; pass it as `after` to continue.
  - nextAfter?: Seq
  # When the urls in this page stop working. Re-list from the committed checkpoint after it.
  - expiresAt?: timestamp

# Read the current retention range.
struct GetCoverageRequest
  # The project to access.
  - project: string

# A project-level scheduling snapshot, not confirmation that any particular event is published.
struct PublicationStatus
  # idle, pending, publishing, retrying, or blocked.
  - state: string
  - observedAt: timestamp
  - intervalSeconds: uint64
  # Approximate eligibility/next retry time; uploads may finish later.
  - estimatedAt?: timestamp

# The current archive range, if an archive exists.
struct GetCoverageResponse
  # The current archive range, or null if unpublished.
  - coverage?: Coverage
    + go.tag.json = coverage
  # Available from an ingest gateway, including before the first archive exists.
  - publication?: PublicationStatus

# A project: one stream of events that many senders (an iOS app, a website, a webhook) write into.
struct ProjectInfo
  # Stable project id (`prj_` and 16 hex digits).
  - id: string
  # Unique alias; editable without changing the id.
  - name: string
  - title?: string
  - createdAt: timestamp

# Metadata for a key. Each key is one sender (a source) of events into the project, named for what sends with it.
struct ApiKey
  # Stable public id derived from the key digest.
  - keyId: string
  # The project this key can access.
  - project: string
  # publishable for sending events, or secret for archive reads.
  - scope: string
  # What this key is for ("ios", "web", "github"). Every event it sends is stamped with this as `sender`.
  - name: string
  # When the key was created.
  - createdAt: timestamp
  # When access was revoked; absent for active keys.
  - revokedAt?: timestamp
  # The key itself, for publishable keys only: they are public by design and can be shown again. Secret keys are never stored.
  - key?: string

struct ListProjectsRequest

struct ListProjectsResponse
  # Projects ordered by id.
  - projects: []ProjectInfo

# Create a project, or return the existing one with this name (so a retry never makes a second project or changes a key).
struct CreateProjectRequest
  - title?: string
  # Applies only when the project is created.
  - geoEnabled?: bool
  # Slurp alias: 1-63 chars of a-z 0-9 _, starting with a letter.
  - name: string

struct CreateProjectResponse
  - project: ProjectInfo
  # False when a project with this name already existed.
  - created: bool
  # The project's first active publishable key (a new "default" key when the project is new).
  - publishableKey: string
  # Absolute public URL for POSTing NDJSON events.
  - ingestUrl: string

struct GetProjectRequest
  # A project id or its name.
  - project: string
struct GetProjectResponse
  - project: ProjectInfo
  - ingestUrl: string
  - geoEnabled: bool
struct UpdateProjectRequest
  - project: string
  - name?: string
  # Empty string clears the optional display title.
  - title?: string
  - geoEnabled?: bool
struct UpdateProjectResponse
  - project: ProjectInfo
  - geoEnabled: bool

# Create a key for a project: one per sender you want to tell apart.
struct CreateKeyRequest
  # The project this key can access.
  - project: string
  # Exactly publishable or secret.
  - scope: string
  # What the key is for, at most 200 UTF-8 bytes. Defaults to "default".
  - name?: string

# A new key. A secret key is shown only now and only its SHA256 is stored; a publishable key can be read again with ListKeys.
struct CreateKeyResponse
  # Stable public id derived from the key digest.
  - keyId: string
  # The slurp_pk_… or slurp_sk_… value.
  - key: string

# List a project's keys, including revoked keys.
struct ListKeysRequest
  # The project to inspect.
  - project: string
  # Optional publishable or secret filter.
  - scope?: string

# Key metadata ordered by creation time, then key id.
struct ListKeysResponse
  # Active and revoked keys matching the filter.
  - keys: []ApiKey

# Revoke either scope of key; repeated calls preserve the revocation time.
struct RevokeKeyRequest
  # The project owning the key.
  - project: string
  # The key's 16 lowercase hex public id.
  - keyId: string

# Where a provider (github, stripe, revenuecat, generic) should send webhooks for a project, and the secret it signs them with.
struct GetWebhookRequest
  - project: string
  # github, stripe, revenuecat or generic.
  - provider: string
  # Change this project's derived webhook secrets (github, revenuecat and generic). The URL does not change.
  - rotate?: bool
  # The signing secret the provider issued, for providers that choose their own (Stripe's `whsec_...`). It is stored for this project.
  - secret?: string

struct GetWebhookResponse
  - provider: string
  # The finished URL, including the project's publishable key named for the provider (created on first use).
  - url: string
  # For github and generic: paste this into the provider as the signing secret; for revenuecat: paste it as the Authorization header value
  # (derived, so asking again returns the same value).
  # For stripe: the secret you gave, or empty until you do (Stripe issues its own).
  - secret: string
  # The name of the key, which is what every event from this provider carries as `sender`.
  - keyName: string

# Metadata for the revoked key.
struct RevokeKeyResponse
  # The key with its original revocation time.
  - key: ApiKey

# Read public server version information.
struct VersionRequest

# Server and protocol versions.
struct VersionResponse
  # The server build.
  - server: string
  # This schema's version (`version` above).
  - schema: string
  # The webrpc generator version.
  - webrpc: string

error 1000 Unauthenticated "authentication required" HTTP 401
error 1001 Forbidden "not allowed" HTTP 403
error 2000 InvalidArgument "invalid argument" HTTP 400
error 2001 AlreadyExists "project name already exists" HTTP 409
error 3000 NotFound "not found" HTTP 404
# The sequences after `after` are below the retention floor; call GetCoverage for the range.
error 4000 RetentionGap "sequences after the checkpoint are past the retention floor" HTTP 410
error 5000 Unavailable "temporarily unavailable" HTTP 503

# Archive reads, authorized by the admin token or a project's secret key.
service Archive
  # List archive objects after an optional committed checkpoint.
  - ListObjects(ListObjectsRequest) => (ListObjectsResponse)
    + @public
    + error Unauthenticated | Forbidden | InvalidArgument | RetentionGap | Unavailable
  # Read the current archive and retention floor.
  - GetCoverage(GetCoverageRequest) => (GetCoverageResponse)
    + @public
    + error Unauthenticated | Forbidden | InvalidArgument | Unavailable

# Control plane: the admin token only. Keys are refused with Forbidden.
service Project
  - GetProject(GetProjectRequest) => (GetProjectResponse)
    + @internal
    + error Unauthenticated | Forbidden | InvalidArgument | NotFound | Unavailable
  - UpdateProject(UpdateProjectRequest) => (UpdateProjectResponse)
    + @internal
    + error Unauthenticated | Forbidden | InvalidArgument | NotFound | AlreadyExists | Unavailable
  - ListProjects(ListProjectsRequest) => (ListProjectsResponse)
    + @internal
    + error Unauthenticated | Forbidden | Unavailable
  # Create a project and its first "default" publishable key, or return the existing project of that name. Repeating the call
  # never creates a second project and never changes a key.
  - CreateProject(CreateProjectRequest) => (CreateProjectResponse)
    + @internal
    + error Unauthenticated | Forbidden | InvalidArgument | Unavailable
  # Create a publishable or secret key.
  - CreateKey(CreateKeyRequest) => (CreateKeyResponse)
    + @internal
    + error Unauthenticated | Forbidden | InvalidArgument | NotFound | Unavailable
  # List active and revoked keys, optionally filtered by scope.
  - ListKeys(ListKeysRequest) => (ListKeysResponse)
    + @internal
    + error Unauthenticated | Forbidden | InvalidArgument | NotFound | Unavailable
  # The webhook URL and signing secret for a provider. Creates the provider's key on first use; repeating the call changes nothing
  # unless `rotate` is set.
  - GetWebhook(GetWebhookRequest) => (GetWebhookResponse)
    + @internal
    + error Unauthenticated | Forbidden | InvalidArgument | NotFound | Unavailable
  # Revoke a key without changing an earlier revocation time.
  - RevokeKey(RevokeKeyRequest) => (RevokeKeyResponse)
    + @internal
    + error Unauthenticated | Forbidden | InvalidArgument | NotFound | Unavailable

# Public server health information.
service Health
  # Read server, schema and generator versions.
  - Version(VersionRequest) => (VersionResponse)
    + @public

# Which key is this? Any valid key can ask, so a CLI or a bot can check a saved token without trying a real operation.
struct WhoamiRequest

struct WhoamiResponse
  # admin for the Worker's admin token; secret (reads archives) or publishable (sends events) for a project key.
  - scope: string
  # The project a key belongs to. Absent for the admin token, which can use every project.
  - project?: string
  # The key's name (the sender it stamps on events). Absent for the admin token.
  - name?: string

service Auth
  # Check the bearer token and say what it can do. Fails with Unauthenticated for an unknown, revoked or missing token.
  - Whoami(WhoamiRequest) => (WhoamiResponse)
    + @public
    + error Unauthenticated | Unavailable
