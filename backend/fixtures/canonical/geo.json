{
 "description": "Geo enrichment. normalize: input is request.cf. Rules (trusted ingress only; country uppercased and must be 2 letters, XX and T1 dropped; values <= 256 chars; provider/basis added). splice: geo is added to context without changing any other byte; the Go test requires wide numbers to survive.",
 "normalize": [
  {
   "name": "full",
   "cf": {
    "country": "CA",
    "region": "Saskatchewan",
    "city": "Regina"
   },
   "geo": {
    "basis": "request_ip",
    "city": "Regina",
    "country": "CA",
    "provider": "cloudflare",
    "region": "Saskatchewan"
   }
  },
  {
   "name": "lowercase country is uppercased",
   "cf": {
    "country": "ca"
   },
   "geo": {
    "basis": "request_ip",
    "country": "CA",
    "provider": "cloudflare"
   }
  },
  {
   "name": "XX dropped",
   "cf": {
    "country": "XX",
    "city": "Nowhere"
   },
   "geo": {
    "basis": "request_ip",
    "city": "Nowhere",
    "provider": "cloudflare"
   }
  },
  {
   "name": "T1 (Tor) dropped, nothing left",
   "cf": {
    "country": "T1"
   },
   "geo": null
  },
  {
   "name": "three letters dropped",
   "cf": {
    "country": "USA"
   },
   "geo": null
  },
  {
   "name": "whitespace trimmed",
   "cf": {
    "city": "  Regina  "
   },
   "geo": {
    "basis": "request_ip",
    "city": "Regina",
    "provider": "cloudflare"
   }
  },
  {
   "name": "overlong value dropped",
   "cf": {
    "city": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "country": "US"
   },
   "geo": {
    "basis": "request_ip",
    "country": "US",
    "provider": "cloudflare"
   }
  },
  {
   "name": "non-string values ignored",
   "cf": {
    "country": 5,
    "city": null
   },
   "geo": null
  },
  {
   "name": "no cf at all",
   "cf": null,
   "geo": null
  }
 ],
 "splice": [
  {
   "name": "no context: appended",
   "line": "{\"id\":\"one\",\"type\":\"track\",\"event\":\"purchase\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"data\":{\"wide\":9007199254740993123456789,\"text\":\"雪\"}}",
   "geo": {
    "country": "CA"
   },
   "expected": "{\"id\":\"one\",\"type\":\"track\",\"event\":\"purchase\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"data\":{\"wide\":9007199254740993123456789,\"text\":\"雪\"},\"context\":{\"geo\":{\"country\":\"CA\"}}}"
  },
  {
   "name": "existing context: geo added, app preserved",
   "line": "{\"id\":\"one\",\"type\":\"track\",\"event\":\"purchase\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"context\":{\"app\":{\"version\":\"before\"}},\"data\":{\"wide\":9007199254740993123456789,\"text\":\"雪\"}}",
   "geo": {
    "country": "CA"
   },
   "expected": "{\"id\":\"one\",\"type\":\"track\",\"event\":\"purchase\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"context\":{\"app\":{\"version\":\"before\"},\"geo\":{\"country\":\"CA\"}},\"data\":{\"wide\":9007199254740993123456789,\"text\":\"雪\"}}"
  },
  {
   "name": "empty context",
   "line": "{\"id\":\"one\",\"type\":\"track\",\"event\":\"purchase\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"context\":{},\"data\":{\"wide\":9007199254740993123456789,\"text\":\"雪\"}}",
   "geo": {
    "country": "CA"
   },
   "expected": "{\"id\":\"one\",\"type\":\"track\",\"event\":\"purchase\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"context\":{\"geo\":{\"country\":\"CA\"}},\"data\":{\"wide\":9007199254740993123456789,\"text\":\"雪\"}}"
  },
  {
   "name": "whitespace inside context preserved",
   "line": "{\"id\":\"one\",\"type\":\"track\",\"event\":\"purchase\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"context\": { \"a\" : 1 } ,\"data\":{\"wide\":9007199254740993123456789,\"text\":\"雪\"}}",
   "geo": {
    "country": "CA"
   },
   "expected": "{\"id\":\"one\",\"type\":\"track\",\"event\":\"purchase\",\"timestamp\":\"2026-11-03T00:00:00Z\",\"context\": { \"a\" : 1 ,\"geo\":{\"country\":\"CA\"}} ,\"data\":{\"wide\":9007199254740993123456789,\"text\":\"雪\"}}"
  }
 ]
}