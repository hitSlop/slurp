{{- define "clients" -}}
fn decode_detail(message: &str, body: &[u8]) -> String {
    let snippet: String = String::from_utf8_lossy(body).chars().take(200).collect();
    format!("{message}; body: {snippet}")
}

async fn rpc_post<T: serde::Serialize + ?Sized, R: serde::de::DeserializeOwned>(
    http: &reqwest::Client, url: String, bearer: Option<&str>, req: &T,
) -> Result<R, Error> {
    let mut request = http.post(url)
        .header(reqwest::header::CONTENT_TYPE, "application/json")
        .header(reqwest::header::ACCEPT, "application/json")
        .header(WEBRPC_HEADER, WEBRPC_HEADER_VALUE)
        .json(req);
    if let Some(token) = bearer {
        request = request.bearer_auth(token);
    }
    let response = request.send().await
        .map_err(|e| Error::Transport(e.without_url().to_string()))?;
    let status = response.status();
    let body = response.bytes().await
        .map_err(|e| Error::Transport(e.without_url().to_string()))?;
    if status.is_success() {
        serde_json::from_slice(&body).map_err(|e| Error::Decode { status: status.as_u16(), detail: decode_detail(&e.to_string(), &body) })
    } else {
        let error: RpcErrorBody = serde_json::from_slice(&body)
            .map_err(|e| Error::Decode { status: status.as_u16(), detail: decode_detail(&e.to_string(), &body) })?;
        if error.name.is_empty() || !(100..=599).contains(&error.status) {
            return Err(Error::Decode { status: status.as_u16(), detail: decode_detail("invalid webrpc error envelope", &body) });
        }
        Err(error.into_error())
    }
}

