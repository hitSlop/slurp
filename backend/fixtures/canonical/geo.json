{
 "description": "Geo from request.cf (docs/contracts.md, \"Archives\"): city, country and region, sorted by key. Values are trimmed and at most 256 characters; the country is uppercased and must be two letters, never XX or T1. Nothing else is added.",
 "normalize": [
  {
   "name": "full",
   "cf": {
    "country": "CA",
    "region": "Saskatchewan",
    "city": "Regina"
   },
   "geo": {
    "city": "Regina",
    "country": "CA",
    "region": "Saskatchewan"
   }
  },
  {
   "name": "lowercase country is uppercased",
   "cf": {
    "country": "ca"
   },
   "geo": {
    "country": "CA"
   }
  },
  {
   "name": "XX dropped",
   "cf": {
    "country": "XX",
    "city": "Nowhere"
   },
   "geo": {
    "city": "Nowhere"
   }
  },
  {
   "name": "T1 (Tor) dropped, nothing left",
   "cf": {
    "country": "T1"
   },
   "geo": null
  },
  {
   "name": "three letters dropped",
   "cf": {
    "country": "USA"
   },
   "geo": null
  },
  {
   "name": "whitespace trimmed",
   "cf": {
    "city": "  Regina  "
   },
   "geo": {
    "city": "Regina"
   }
  },
  {
   "name": "overlong value dropped",
   "cf": {
    "city": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "country": "US"
   },
   "geo": {
    "country": "US"
   }
  },
  {
   "name": "non-string values ignored",
   "cf": {
    "country": 5,
    "city": null
   },
   "geo": null
  },
  {
   "name": "no cf at all",
   "cf": null,
   "geo": null
  }
 ]
}
