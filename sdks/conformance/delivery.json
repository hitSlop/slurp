{
  "description": "Delivery scenarios every Slurp SDK must pass. A runner records events named in `events`, then flushes until nothing is pending or the client stops. The server answers each request from `responses` in order (a status of 0 is a network error) and with 200 after that. `requests` lists the event names in each request the server saw, in order. A retry of a request must carry exactly the bytes of the request it retries. Add a scenario here when a delivery bug is found, so every SDK gets the test.",
  "scenarios": [
    { "name": "everything is delivered in one request",
      "events": ["a", "b"], "responses": [],
      "expect": { "requests": [["a", "b"]], "accepted": 2, "rejected": 0, "stopped": false, "pending": 0 } },
    { "name": "408 is retried with identical bytes",
      "events": ["a", "b"], "responses": [{ "status": 408 }],
      "expect": { "requests": [["a", "b"], ["a", "b"]], "identicalRetries": true, "accepted": 2, "rejected": 0, "stopped": false, "pending": 0 } },
    { "name": "429 honours Retry-After and retries identical bytes",
      "events": ["a", "b"], "responses": [{ "status": 429, "retryAfter": "0" }],
      "expect": { "requests": [["a", "b"], ["a", "b"]], "identicalRetries": true, "accepted": 2, "rejected": 0, "stopped": false, "pending": 0 } },
    { "name": "503 is retried with identical bytes",
      "events": ["a", "b"], "responses": [{ "status": 503 }],
      "expect": { "requests": [["a", "b"], ["a", "b"]], "identicalRetries": true, "accepted": 2, "rejected": 0, "stopped": false, "pending": 0 } },
    { "name": "500 twice then success resends identical bytes each time",
      "events": ["a"], "responses": [{ "status": 500 }, { "status": 500 }],
      "expect": { "requests": [["a"], ["a"], ["a"]], "identicalRetries": true, "accepted": 1, "rejected": 0, "stopped": false, "pending": 0 } },
    { "name": "a network error is retried with identical bytes",
      "events": ["a", "b"], "responses": [{ "status": 0 }],
      "expect": { "requests": [["a", "b"], ["a", "b"]], "identicalRetries": true, "accepted": 2, "rejected": 0, "stopped": false, "pending": 0 } },
    { "name": "400 drops the batch and keeps going",
      "events": ["a", "b"], "responses": [{ "status": 400 }],
      "expect": { "requests": [["a", "b"]], "accepted": 0, "rejected": 2, "stopped": false, "pending": 0 } },
    { "name": "401 stops the client and drops everything that was waiting",
      "options": { "maxBatchEvents": 2 }, "events": ["a", "b", "c"], "responses": [{ "status": 401 }],
      "expect": { "requests": [["a", "b"]], "accepted": 0, "rejected": 3, "stopped": true, "pending": 0 } },
    { "name": "403 stops the client and drops everything that was waiting",
      "options": { "maxBatchEvents": 2 }, "events": ["a", "b", "c"], "responses": [{ "status": 403 }],
      "expect": { "requests": [["a", "b"]], "accepted": 0, "rejected": 3, "stopped": true, "pending": 0 } },
    { "name": "413 splits the batch, first half the larger one, and delivers every event once",
      "events": ["a", "b", "c"], "responses": [{ "status": 413 }],
      "expect": { "requests": [["a", "b", "c"], ["a", "b"], ["c"]], "accepted": 3, "rejected": 0, "stopped": false, "pending": 0 } },
    { "name": "413 on a single event drops only that event",
      "events": ["a"], "responses": [{ "status": 413 }],
      "expect": { "requests": [["a"]], "accepted": 0, "rejected": 1, "stopped": false, "pending": 0 } },
    { "name": "413 keeps splitting until the oversized event is alone, then drops just it",
      "events": ["a", "b"], "responses": [{ "status": 413 }, { "status": 413 }],
      "expect": { "requests": [["a", "b"], ["a"], ["b"]], "accepted": 1, "rejected": 1, "stopped": false, "pending": 0 } },
    { "name": "every 2xx status is an acknowledgement",
      "events": ["a"], "responses": [{ "status": 201 }],
      "expect": { "requests": [["a"]], "accepted": 1, "rejected": 0, "stopped": false, "pending": 0 } },
    { "name": "204 No Content is an acknowledgement",
      "events": ["a"], "responses": [{ "status": 204 }],
      "expect": { "requests": [["a"]], "accepted": 1, "rejected": 0, "stopped": false, "pending": 0 } }
  ]
}
